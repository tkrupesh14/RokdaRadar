# Base URL of the ReliefTrace backend (see ../backend). Used by lib/api.ts.
# Copy this file to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Must match backend/.env's MONAD_EXPLORER_TX_BASE_URL. Used to build
# "View on Monad Explorer" links for real transaction hashes.
NEXT_PUBLIC_MONAD_EXPLORER_TX_BASE_URL=https://testnet.monadscan.com/tx

# WalletConnect Cloud project ID (cloud.walletconnect.com). Used by
# lib/wallet.ts so mobile Chrome can connect via a MetaMask deep-link
# session (approve-then-return-to-Chrome) instead of only working inside
# MetaMask's own in-app browser.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
