# Server
PORT=4000
NODE_ENV=development

# Database / storage
# Postgres connection string (Supabase project: Project Settings > Database >
# Connection string > URI). REQUIRED SECRET, user-supplied, never commit a
# real value -- includes the DB password.
DATABASE_URL=
# A SEPARATE database (a second Supabase project, or any scratch Postgres)
# used only by `npm test` -- test/testDb.ts TRUNCATEs every table before each
# test file. Tests refuse to run (see src/db/client.ts) if this is unset or
# equals DATABASE_URL, since that would wipe real data.
TEST_DATABASE_URL=
EVIDENCE_DIR=./evidence-store
# "local" (default) is the MVP0 tier -- filesystem + SHA-256 hash standing in
# for a real CID, doesn't survive redeploys. "ipfs" pins evidence to Pinata
# for a real, durable CID (LLD Section 6 MVP1 tier); PINATA_JWT is required
# when this is "ipfs" -- the server refuses to boot without it.
EVIDENCE_STORAGE_BACKEND=local
# Pinata API JWT (app.pinata.cloud > API Keys). REQUIRED SECRET when
# EVIDENCE_STORAGE_BACKEND=ipfs, never commit a real value.
PINATA_JWT=

# Monad testnet chain config
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143
MONAD_EXPLORER_TX_BASE_URL=https://testnet.monadscan.com/tx
CONTRACT_ADDRESS=

# Signing keys -- REQUIRED SECRETS, user-supplied, never commit real values
# Funded Monad testnet private key. Deploys the contract and signs attestSpend/createCampaign txs.
OPERATOR_PRIVATE_KEY=
# Backend key permitted to call attestDonation. Defaults to OPERATOR_PRIVATE_KEY for MVP0 demo simplicity.
ORACLE_PRIVATE_KEY=

# Auth
WEBHOOK_HMAC_SECRET=change-me-dev-secret
ATTESTOR_ALLOWLIST=
# Comma-separated addresses allowed to approve/reject pending spends via
# POST /api/pending-spends/:id/approve|reject. Empty = open (any validly
# signed request may review), same MVP0 default as ATTESTOR_ALLOWLIST.
MANAGER_ALLOWLIST=

# Real Razorpay integration (issue #6) -- optional. Unset means
# POST /api/campaigns/:id/donate/order 503s and the mocked
# POST /api/campaigns/:id/donate flow keeps working exactly as before.
# Get RAZORPAY_KEY_ID/SECRET from the Razorpay Dashboard (Settings > API
# Keys, test mode for development). REQUIRED SECRETS, never commit real
# values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure this in the Razorpay Dashboard (Settings > Webhooks) once a
# public webhook URL exists to register there -- it's not returned by any
# API call, you choose it when you create the webhook.
RAZORPAY_WEBHOOK_SECRET=

# Per-IP rate limits on public, chain-writing endpoints (donate, PSP
# webhook). Defaults are sized for real traffic -- see area:security issue
# #19. Lower the donate values if abuse is observed; raise the webhook
# values if the real PSP's retry/burst behavior needs more headroom.
RATE_LIMIT_DONATE_WINDOW_MS=60000
RATE_LIMIT_DONATE_MAX=10
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=120
# How long a processed webhook payment.id is remembered for idempotency
# dedup before being pruned, in ms. Default 24h matches typical PSP webhook
# retry windows.
WEBHOOK_IDEMPOTENCY_WINDOW_MS=86400000

# AI -- at least one provider's key is a REQUIRED SECRET, user-supplied.
# AI_PROVIDER picks which one is used; leave unset to auto-select (prefers
# Gemini if both keys are present -- see src/config/env.ts).
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
# "-latest" alias (not a pinned version) so this doesn't go stale as Google
# deprecates specific model IDs over time. Flash-Lite is the cheapest tier;
# reports are short structured JSON grounded by the guardrail
# (src/ai/guardrail.ts), not by model size, so this is a safe default.
GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic (alternative provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Misc
LOG_LEVEL=info
