# Server
PORT=4000
NODE_ENV=development

# Database / storage
# Postgres connection string (Supabase project: Project Settings > Database >
# Connection string > URI). REQUIRED SECRET, user-supplied, never commit a
# real value -- includes the DB password.
DATABASE_URL=
# A SEPARATE database (a second Supabase project, or any scratch Postgres)
# used only by `npm test` -- test/testDb.ts TRUNCATEs every table before each
# test file. Tests refuse to run (see src/db/client.ts) if this is unset or
# equals DATABASE_URL, since that would wipe real data.
TEST_DATABASE_URL=
EVIDENCE_DIR=./evidence-store

# Monad testnet chain config
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143
MONAD_EXPLORER_TX_BASE_URL=https://testnet.monadscan.com/tx
CONTRACT_ADDRESS=

# Signing keys -- REQUIRED SECRETS, user-supplied, never commit real values
# Funded Monad testnet private key. Deploys the contract and signs attestSpend/createCampaign txs.
OPERATOR_PRIVATE_KEY=
# Backend key permitted to call attestDonation. Defaults to OPERATOR_PRIVATE_KEY for MVP0 demo simplicity.
ORACLE_PRIVATE_KEY=

# Auth
WEBHOOK_HMAC_SECRET=change-me-dev-secret
ATTESTOR_ALLOWLIST=
# Comma-separated addresses allowed to approve/reject pending spends via
# POST /api/pending-spends/:id/approve|reject. Empty = open (any validly
# signed request may review), same MVP0 default as ATTESTOR_ALLOWLIST.
MANAGER_ALLOWLIST=

# AI -- at least one provider's key is a REQUIRED SECRET, user-supplied.
# AI_PROVIDER picks which one is used; leave unset to auto-select (prefers
# Gemini if both keys are present -- see src/config/env.ts).
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
# "-latest" alias (not a pinned version) so this doesn't go stale as Google
# deprecates specific model IDs over time. Flash-Lite is the cheapest tier;
# reports are short structured JSON grounded by the guardrail
# (src/ai/guardrail.ts), not by model size, so this is a safe default.
GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic (alternative provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Misc
LOG_LEVEL=info
